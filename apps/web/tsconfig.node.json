{
    "compilerOptions": {
        "composite": true,
        "target": "ES2023",
        "lib": ["ES2023"],
        "skipLibCheck": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "moduleDetection": "force",
        "noEmit": true,
        "strict": true,
        "types": ["node"]
    },
    "include": ["vite.config.ts", "playwright.config.ts"]
}
