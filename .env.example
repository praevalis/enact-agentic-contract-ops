ENACT_ENVIRONMENT=development
ENACT_LOG_LEVEL=INFO
ENACT_API_HOST=0.0.0.0
ENACT_API_PORT=8000
ENACT_WEB_ORIGIN=http://localhost:5173

POSTGRES_DB=enact
POSTGRES_USER=enact_bootstrap
POSTGRES_PASSWORD=local-bootstrap-only
ENACT_MIGRATE_PASSWORD=local-migrate-only
ENACT_APP_PASSWORD=local-app-only
ENACT_MIGRATION_DATABASE_URL=postgresql+asyncpg://enact_migrate:local-migrate-only@postgres:5432/enact
ENACT_DATABASE_URL=postgresql+asyncpg://enact_app:local-app-only@postgres:5432/enact

MINIO_ROOT_USER=enact-local
MINIO_ROOT_PASSWORD=enact-local-secret
ENACT_OBJECT_STORAGE_ENDPOINT=http://object-store:9000
ENACT_OBJECT_STORAGE_ACCESS_KEY=enact-local
ENACT_OBJECT_STORAGE_SECRET_KEY=enact-local-secret
ENACT_OBJECT_STORAGE_BUCKET=enact-documents
